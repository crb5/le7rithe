# Automatic HTTPS (Let's Encrypt) for the app and Authentik.
# Point le7rithe.com and auth.le7rithe.com DNS A/AAAA records at this host, and
# open ports 80 and 443. Caddy terminates TLS and forwards plain HTTP to the
# containers, setting X-Forwarded-Proto so the app issues secure cookies.

le7rithe.com {
	# Same-origin path for the custom login/register pages' flow-executor XHR
	# calls to Authentik (see agri-market/src/lib/oidc-flow.ts), so they need
	# no CORS and their session cookie is first-party to this domain.
	handle_path /authentik-api/* {
		reverse_proxy authentik-server:9000 {
			# Authentik's flow executor sometimes replies to a stage POST with a
			# 302 to its own root-relative path (e.g. "/api/v3/flows/executor/..."),
			# with no idea it's reached through this stripped /authentik-api
			# prefix. Left alone, the browser follows that redirect straight past
			# this proxy to the app itself, which 404s. Re-add the prefix so the
			# follow-up request comes back through here.
			header_down Location "^/(.*)" "/authentik-api/${1}"
		}
	}
	reverse_proxy app:3000
}

auth.le7rithe.com {
	reverse_proxy authentik-server:9000
}
