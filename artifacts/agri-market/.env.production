# Build-time SPA config for production (domain: le7rithe.com).
# These are inlined into the JS bundle and are NOT secret (a public client id
# and public URLs), so they are committed and read by `vite build` in CI and in
# the Docker image — no GitHub secrets needed for them.
#
# Fill VITE_OIDC_CLIENT_ID once you create the Authentik OAuth2/OIDC provider,
# then rebuild the image.
VITE_OIDC_ISSUER=https://auth.le7rithe.com/application/o/agri-market/
VITE_OIDC_CLIENT_ID=OVni27mCP85v0lsKMWCqXbLJKEqgXSDf9l1nGpHY
VITE_OIDC_REDIRECT_URI=https://le7rithe.com/auth/callback
