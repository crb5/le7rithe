{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "build": "yarn run typecheck && yarn workspaces foreach -Ap --exclude workspace run build",
    "deploy": "node scripts/deploy-docker.mjs",
    "validate:development-schema": "yarn workspace @workspace/db run check:development-schema",
    "setup:e2e-auth": "node e2e/setup-auth.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:private-payment-review": "node scripts/run-private-payment-review.mjs",
    "test:private-payment-review-runner": "node --test scripts/run-private-payment-review.test.mjs",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:libs": "tsc --build",
    "typecheck": "yarn run typecheck:libs && yarn workspaces foreach -Ap --include @workspace/agri-market --include @workspace/api-server --include @workspace/mockup-sandbox --include @workspace/scripts run typecheck && yarn run typecheck:e2e"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.3.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.28.1",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  }
}
