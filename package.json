{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "validate:development-schema": "pnpm --filter @workspace/db run check:development-schema",
    "setup:e2e-auth": "node e2e/setup-auth.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:private-payment-review": "node scripts/run-private-payment-review.mjs",
    "test:private-payment-review-runner": "node --test scripts/run-private-payment-review.test.mjs",
    "test:private-object-storage-cleanup": "pnpm --filter @workspace/api-server run test:live-object-storage-cleanup",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck && pnpm run typecheck:e2e"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
